      return "UNKNOWN";
  }
}

// =========================================================
// SYSTEM STATUS
// =========================================================

void printSystemStatus()
{
  Serial.println();
  Serial.println(
    "========================================"
  );

  Serial.println(
    "BMS SYSTEM STATUS"
  );

  Serial.println(
    "========================================"
  );

  for (int i = 0; i < CELL_COUNT; i++)
  {
    Serial.print("Cell ");
    Serial.print(i + 1);
    Serial.print(": ");
    Serial.print(
      cellVoltage[i],
      3
    );
    Serial.println(" V");
  }

  Serial.println(
    "----------------------------------------"
  );

  Serial.print("SoC: ");
  Serial.print(
    getAverageSoC(),
    1
  );
  Serial.println("%");

  Serial.print("Weakest Cell: ");
  Serial.println(
    getWeakestCell() + 1
  );

  Serial.print("Imbalance: ");
  Serial.print(
    getVoltageImbalance(),
    3
  );
  Serial.println(" V");

  Serial.print("Relay Command: ");
  Serial.println(
    relayState
    ? "ON"
    : "OFF"
  );

  Serial.print("Relay Actual: ");
  Serial.println(
    actualRelayState
    ? "ON"
    : "OFF"
  );

  Serial.print("State: ");
  Serial.println(
    getStateName(
      currentState
    )
  );

  Serial.print("Fault ID: ");
  Serial.println(
    getFaultName(
      activeFault
    )
  );

  Serial.print("Fault Source: ");
  Serial.println(
    getFaultSourceName(
      activeFaultSource
    )
  );

  Serial.println(
    "========================================"
  );
}

// =========================================================
// SOC
// =========================================================

float getAverageSoC()
{
  float totalVoltage = 0;

  for (int i = 0; i < CELL_COUNT; i++)
  {
    totalVoltage +=
      cellVoltage[i];
  }

  float averageVoltage =
    totalVoltage / CELL_COUNT;

  float soc =
    (
      (averageVoltage - 3.0)
      /
      1.2
    )
    * 100.0;

  if (soc > 100)
  {
    soc = 100;
  }

  if (soc < 0)
  {
    soc = 0;
  }

  return soc;
}

// =========================================================
// VOLTAGE IMBALANCE
// =========================================================

float getVoltageImbalance()
{
  float minimumVoltage =
    cellVoltage[0];

  float maximumVoltage =
    cellVoltage[0];

  for (
    int i = 1;
    i < CELL_COUNT;
    i++
  )
  {
    if (
      cellVoltage[i]
      < minimumVoltage
    )
    {
      minimumVoltage =
        cellVoltage[i];
    }

    if (
      cellVoltage[i]
      > maximumVoltage
    )
    {
      maximumVoltage =
        cellVoltage[i];
    }
  }

  return
    maximumVoltage -
    minimumVoltage;
}

// =========================================================
// WEAKEST CELL
// =========================================================

int getWeakestCell()
{
  int weakestCell = 0;

  for (
    int i = 1;
    i < CELL_COUNT;
    i++
  )
  {
    if (
      cellVoltage[i]
      < cellVoltage[weakestCell]
    )
    {
      weakestCell = i;
    }
  }

  return weakestCell;
}

// =========================================================
// LCD LINE WRITER
// =========================================================

void writeLCDLine(
  byte row,
  String text,
  bool force
)
{
  while (
    text.length()
    < LCD_COLUMNS
  )
  {
    text += " ";
  }

  if (
    text.length()
    > LCD_COLUMNS
  )
  {
    text =
      text.substring(
        0,
        LCD_COLUMNS
      );
  }

  String* cache =
    (
      row == 0
      ?
      &lcdCacheLine1
      :
      &lcdCacheLine2
    );

  // Update only if changed
  if (
    force ||
    *cache != text
  )
  {
    lcd.setCursor(
      0,
      row
    );

    lcd.print(text);

    *cache = text;
  }
}

// =========================================================
// LCD FAULT SCREEN
// =========================================================

void showFaultScreen()
{
  String line1;
  String line2;

  if (
    currentState == SHUTDOWN
  )
  {
    line1 = "!! SHUTDOWN";
  }
  else
  {
    line1 =
      "!! " +
      String(
        getStateName(
          currentState
        )
      );
  }

  line2 =
    String(
      getFaultName(
        activeFault
      )
    );

  writeLCDLine(
    0,
    line1,
    forceLcdRedraw
  );

  writeLCDLine(
    1,
    line2,
    forceLcdRedraw
  );

  forceLcdRedraw = false;
}

// =========================================================
// LCD NORMAL PAGES
// =========================================================

void showNormalPage()
{
  String line1;
  String line2;

  // PAGE 1
  if (currentPage == 0)
  {
    line1 =
      "BATTERY STATUS";

    line2 =
      "SoC:" +
      String(
        getAverageSoC(),
        1
      ) +
      "%";
  }

  // PAGE 2
  else if (currentPage == 1)
  {
    line1 =
      "Relay:" +
      String(
        relayState
        ? "ON"
        : "OFF"
      );

    line2 =
      String(
        getStateName(
          currentState
        )
      );
  }

  // PAGE 3
  else
  {
    int weakest =
      getWeakestCell();

    line1 =
      "Weak:C" +
      String(
        weakest + 1
      ) +
      " Imb:" +
      String(
        getVoltageImbalance(),
        2
      );

    line2 =
      "C1:" +
      String(
        cellVoltage[0],
        2
      ) +
      " C4:" +
      String(
        cellVoltage[3],
        2
      );
  }

  writeLCDLine(
    0,
    line1,
    forceLcdRedraw
  );

  writeLCDLine(
    1,
    line2,
    forceLcdRedraw
  );

  forceLcdRedraw = false;
}

// =========================================================
// LCD ENGINE
// =========================================================

void updateLCDDisplay()
{
  unsigned long currentTime =
    millis();

  // Critical state
  if (
    currentState == FAILSAFE ||
    currentState == SHUTDOWN
  )
  {
    if (
      currentTime -
      lastLcdRefreshTime
      >= LCD_REFRESH_INTERVAL
      ||
      forceLcdRedraw
    )
    {
      lastLcdRefreshTime =
        currentTime;

      showFaultScreen();
    }

    return;
  }

  // Page rotation
  if (
    currentTime -
    lastPageChangeTime
    >= PAGE_ROTATION_INTERVAL
  )
  {
    lastPageChangeTime =
      currentTime;

    currentPage++;

    if (
      currentPage >= 3
    )
    {
      currentPage = 0;
    }

    forceLcdRedraw = true;
  }

  // LCD refresh
  if (
    currentTime -
    lastLcdRefreshTime
    >= LCD_REFRESH_INTERVAL
    ||
    forceLcdRedraw
  )
  {
    lastLcdRefreshTime =
      currentTime;

    showNormalPage();
  }
}
