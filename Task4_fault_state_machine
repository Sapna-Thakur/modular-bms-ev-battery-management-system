#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <math.h>

// =========================================================
// ESP32 BMS SAFETY SYSTEM
// TASK 3 + TASK 4
//
// States:
// NORMAL -> DEGRADED -> FAILSAFE -> NORMAL
// Critical Relay Fault:
// NORMAL -> DEGRADED -> SHUTDOWN
// =========================================================

#define CELL_COUNT 4

// =========================================================
// LCD
// =========================================================

#define LCD_ADDRESS 0x27
#define LCD_COLUMNS 16
#define LCD_ROWS 2

LiquidCrystal_I2C lcd(
  LCD_ADDRESS,
  LCD_COLUMNS,
  LCD_ROWS
);

const unsigned long LCD_REFRESH_INTERVAL = 250;
const unsigned long PAGE_ROTATION_INTERVAL = 3000;

unsigned long lastLcdRefreshTime = 0;
unsigned long lastPageChangeTime = 0;

int currentPage = 0;

bool forceLcdRedraw = true;

String lcdCacheLine1 = "";
String lcdCacheLine2 = "";

// =========================================================
// TIMING
// =========================================================

const unsigned long SAMPLE_INTERVAL = 500;
const unsigned long DEBOUNCE_TIME = 1500;
const unsigned long RECOVERY_TIME = 5000;
const unsigned long FROZEN_TIME = 3000;

// =========================================================
// VOLTAGE LIMITS
// =========================================================

const float UNDER_VOLTAGE_TRIP = 3.20;
const float OVER_VOLTAGE_TRIP = 4.25;

const float UNDER_VOLTAGE_RECOVER = 3.35;
const float OVER_VOLTAGE_RECOVER = 4.15;

const float SENSOR_MIN = 2.50;
const float SENSOR_MAX = 4.35;

const float MAX_VOLTAGE_JUMP = 0.35;
const float FROZEN_TOLERANCE = 0.0001;

// =========================================================
// SYSTEM STATES
// =========================================================

enum SystemState
{
  NORMAL,
  DEGRADED,
  FAILSAFE,
  SHUTDOWN
};

// =========================================================
// FAULT TYPES
// =========================================================

enum FaultType
{
  NO_FAULT,
  UNDER_VOLTAGE,
  OVER_VOLTAGE,
  FROZEN_ADC,
  ADC_JUMP,
  ADC_OUT_OF_RANGE,
  RELAY_MISMATCH,
  COMMUNICATION_FAILURE
};

// =========================================================
// FAULT SOURCES
// =========================================================

enum FaultSource
{
  SOURCE_NONE,
  SOURCE_BATTERY,
  SOURCE_ADC,
  SOURCE_RELAY,
  SOURCE_COMMUNICATION
};

// =========================================================
// BATTERY DATA
// =========================================================

float cellVoltage[CELL_COUNT] =
{
  3.82,
  3.74,
  3.89,
  3.61
};

float previousVoltage[CELL_COUNT];

unsigned long frozenStartTime[CELL_COUNT];

// =========================================================
// GLOBAL VARIABLES
// =========================================================

SystemState currentState = NORMAL;
SystemState previousState = NORMAL;

FaultType activeFault = NO_FAULT;

FaultSource activeFaultSource = SOURCE_NONE;

unsigned long previousSampleTime = 0;
unsigned long faultStartTime = 0;
unsigned long recoveryStartTime = 0;

bool relayState = true;
bool actualRelayState = true;

int simulationStep = 0;

// =========================================================
// FUNCTION DECLARATIONS
// =========================================================

void updateBatterySimulation();
FaultType detectFault();
FaultSource getFaultSource(FaultType fault);
bool safeForRecovery();

void updateStateMachine();

void transitionTo(
  SystemState newState,
  FaultType fault,
  FaultSource source
);

void setRelay(bool state);

const char* getFaultName(FaultType fault);
const char* getFaultSourceName(FaultSource source);
const char* getStateName(SystemState state);

void printSystemStatus();

float getAverageSoC();
float getVoltageImbalance();
int getWeakestCell();

void updateLCDDisplay();
void showNormalPage();
void showFaultScreen();

void writeLCDLine(
  byte row,
  String text,
  bool force = false
);

// =========================================================
// SETUP
// =========================================================

void setup()
{
  Serial.begin(115200);

  Wire.begin(21, 22);

  lcd.init();
  lcd.backlight();

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("BMS SYSTEM");

  lcd.setCursor(0, 1);
  lcd.print("Starting...");

  // Initialize history
  for (int i = 0; i < CELL_COUNT; i++)
  {
    previousVoltage[i] = cellVoltage[i];
    frozenStartTime[i] = 0;
  }

  Serial.println();
  Serial.println("========================================");
  Serial.println("ESP32 BMS SAFETY SYSTEM");
  Serial.println("TASK 3 + TASK 4");
  Serial.println("SYSTEM STARTING");
  Serial.println("========================================");

  relayState = true;
  actualRelayState = true;

  Serial.println("[SYSTEM] RELAY: ON");
}

// =========================================================
// MAIN LOOP
// =========================================================

void loop()
{
  unsigned long currentTime = millis();

  if (
    currentTime - previousSampleTime
    >= SAMPLE_INTERVAL
  )
  {
    previousSampleTime = currentTime;

    updateBatterySimulation();

    updateStateMachine();

    printSystemStatus();
  }

  updateLCDDisplay();
}

// =========================================================
// BATTERY SIMULATION
// =========================================================

void updateBatterySimulation()
{
  simulationStep++;

  // =======================================================
  // NORMAL OPERATION
  // =======================================================

  if (simulationStep < 12)
  {
    cellVoltage[0] -= 0.002;
    cellVoltage[1] -= 0.003;
    cellVoltage[2] -= 0.001;
    cellVoltage[3] -= 0.002;
  }

  // =======================================================
  // TEST 1 - UNDER VOLTAGE
  // =======================================================

  if (
    simulationStep >= 12 &&
    simulationStep < 20
  )
  {
    if (simulationStep == 12)
    {
      Serial.println();
      Serial.println(
        ">>> FAULT: CELL 4 UNDER VOLTAGE <<<"
      );
    }

    cellVoltage[3] = 3.10;
  }

  // =======================================================
  // UNDER VOLTAGE RECOVERY
  // =======================================================

  if (
    simulationStep >= 20 &&
    simulationStep < 32
  )
  {
    if (simulationStep == 20)
    {
      Serial.println();
      Serial.println(
        ">>> UNDER VOLTAGE CLEARED <<<"
      );
    }

    cellVoltage[3] = 3.60;
  }

  // =======================================================
  // TEST 2 - OVER VOLTAGE
  // =======================================================

  if (
    simulationStep >= 32 &&
    simulationStep < 40
  )
  {
    if (simulationStep == 32)
    {
      Serial.println();
      Serial.println(
        ">>> FAULT: CELL 3 OVER VOLTAGE <<<"
      );
    }

    cellVoltage[2] = 4.30;
  }

  // =======================================================
  // OVER VOLTAGE RECOVERY
  // =======================================================

  if (
    simulationStep >= 40 &&
    simulationStep < 52
  )
  {
    if (simulationStep == 40)
    {
      Serial.println();
      Serial.println(
        ">>> OVER VOLTAGE CLEARED <<<"
      );
    }

    cellVoltage[2] = 4.00;
  }

  // =======================================================
  // TEST 3 - ADC JUMP
  // =======================================================

  if (simulationStep == 52)
  {
    Serial.println();
    Serial.println(
      ">>> FAULT: ADC UNREALISTIC JUMP <<<"
    );

    cellVoltage[1] += 0.60;
  }

  if (
    simulationStep > 52 &&
    simulationStep < 68
  )
  {
    cellVoltage[1] = 3.75;
  }

  // =======================================================
  // TEST 4 - FROZEN ADC
  // =======================================================

  if (
    simulationStep >= 68 &&
    simulationStep < 78
  )
  {
    if (simulationStep == 68)
    {
      Serial.println();
      Serial.println(
        ">>> FAULT: FROZEN ADC CELL 1 <<<"
      );
    }

    // Cell 1 deliberately frozen
    cellVoltage[0] = previousVoltage[0];
  }

  // =======================================================
  // CLEAR FROZEN ADC
  // =======================================================

  if (simulationStep == 78)
  {
    Serial.println();
    Serial.println(
      ">>> FROZEN ADC CLEARED <<<"
    );

    cellVoltage[0] =
      previousVoltage[0] - 0.005;
  }

  // =======================================================
  // TEST 5 - RELAY MISMATCH
  // =======================================================

  if (simulationStep == 90)
  {
    Serial.println();
    Serial.println(
      ">>> FAULT: RELAY MISMATCH <<<"
    );

    // Deliberate hardware mismatch
    actualRelayState = !relayState;
  }

  // =======================================================
  // RELAY RECOVERY
  // =======================================================

  if (
    simulationStep >= 91 &&
    simulationStep < 100
  )
  {
    actualRelayState = relayState;
  }

  // =======================================================
  // AFTER ALL TESTS
  // =======================================================

  if (simulationStep >= 100)
  {
    /*
      Keep values changing slightly.
      This avoids false FROZEN_ADC detection.
    */

    cellVoltage[0] =
      3.82 - ((simulationStep - 100) * 0.001);

    cellVoltage[1] =
      3.75 - ((simulationStep - 100) * 0.001);

    cellVoltage[2] =
      3.90 - ((simulationStep - 100) * 0.001);

    cellVoltage[3] =
      3.65 - ((simulationStep - 100) * 0.001);
  }
}

// =========================================================
// FAULT DETECTION
// =========================================================

FaultType detectFault()
{
  unsigned long currentTime = millis();

  // =======================================================
  // RELAY MISMATCH
  // =======================================================

  if (
    relayState != actualRelayState
  )
  {
    return RELAY_MISMATCH;
  }

  // =======================================================
  // CELL CHECK
  // =======================================================

  for (int i = 0; i < CELL_COUNT; i++)
  {
    float voltage = cellVoltage[i];

    float difference =
      fabs(
        voltage - previousVoltage[i]
      );

    // ADC range
    if (
      voltage < SENSOR_MIN ||
      voltage > SENSOR_MAX
    )
    {
      return ADC_OUT_OF_RANGE;
    }

    // Under voltage
    if (
      voltage <= UNDER_VOLTAGE_TRIP
    )
    {
      return UNDER_VOLTAGE;
    }

    // Over voltage
    if (
      voltage >= OVER_VOLTAGE_TRIP
    )
    {
      return OVER_VOLTAGE;
    }

    // Unrealistic jump
    if (
      difference > MAX_VOLTAGE_JUMP
    )
    {
      return ADC_JUMP;
    }

    // Frozen ADC
    if (
      difference <= FROZEN_TOLERANCE
    )
    {
      if (
        frozenStartTime[i] == 0
      )
      {
        frozenStartTime[i] =
          currentTime;
      }

      if (
        currentTime -
        frozenStartTime[i]
        >= FROZEN_TIME
      )
      {
        return FROZEN_ADC;
      }
    }
    else
    {
      frozenStartTime[i] = 0;
    }
  }

  return NO_FAULT;
}

// =========================================================
// FAULT SOURCE
// =========================================================

FaultSource getFaultSource(
  FaultType fault
)
{
  switch (fault)
  {
    case UNDER_VOLTAGE:
    case OVER_VOLTAGE:
      return SOURCE_BATTERY;

    case FROZEN_ADC:
    case ADC_JUMP:
    case ADC_OUT_OF_RANGE:
      return SOURCE_ADC;

    case RELAY_MISMATCH:
      return SOURCE_RELAY;

    case COMMUNICATION_FAILURE:
      return SOURCE_COMMUNICATION;

    default:
      return SOURCE_NONE;
  }
}

// =========================================================
// SAFE RECOVERY
// =========================================================

bool safeForRecovery()
{
  // Relay agreement
  if (
    relayState != actualRelayState
  )
  {
    return false;
  }

  // Battery recovery limits
  for (int i = 0; i < CELL_COUNT; i++)
  {
    if (
      cellVoltage[i]
      < UNDER_VOLTAGE_RECOVER
    )
    {
      return false;
    }

    if (
      cellVoltage[i]
      > OVER_VOLTAGE_RECOVER
    )
    {
      return false;
    }
  }

  // No remaining fault
  if (
    detectFault() != NO_FAULT
  )
  {
    return false;
  }

  return true;
}

// =========================================================
// STATE TRANSITION LOG
// =========================================================

void transitionTo(
  SystemState newState,
  FaultType fault,
  FaultSource source
)
{
  if (
    currentState == newState
  )
  {
    return;
  }

  previousState = currentState;

  Serial.println();
  Serial.println(
    "----- STATE TRANSITION -----"
  );

  Serial.print("{timestamp:");
  Serial.print(millis());

  Serial.print(", previous:");
  Serial.print(
    getStateName(previousState)
  );

  Serial.print(", new:");
  Serial.print(
    getStateName(newState)
  );

  Serial.print(", fault_id:");
  Serial.print(
    getFaultName(fault)
  );

  Serial.print(", source:");
  Serial.print(
    getFaultSourceName(source)
  );

  Serial.println("}");

  Serial.println(
    "----------------------------"
  );

  currentState = newState;

  forceLcdRedraw = true;
}

// =========================================================
// STATE MACHINE
// =========================================================

void updateStateMachine()
{
  unsigned long currentTime = millis();

  FaultType detectedFault =
    detectFault();

  // =======================================================
  // NORMAL
  // =======================================================

  if (
    currentState == NORMAL
  )
  {
    if (
      detectedFault != NO_FAULT
    )
    {
      activeFault =
        detectedFault;

      activeFaultSource =
        getFaultSource(
          detectedFault
        );

      faultStartTime =
        currentTime;

      transitionTo(
        DEGRADED,
        activeFault,
        activeFaultSource
      );
    }
  }

  // =======================================================
  // DEGRADED
  // =======================================================

  else if (
    currentState == DEGRADED
  )
  {
    // Fault disappeared
    if (
      detectedFault == NO_FAULT
    )
    {
      activeFault = NO_FAULT;
      activeFaultSource = SOURCE_NONE;
      faultStartTime = 0;

      transitionTo(
        NORMAL,
        NO_FAULT,
        SOURCE_NONE
      );
    }

    // Fault confirmed
    else if (
      currentTime -
      faultStartTime
      >= DEBOUNCE_TIME
    )
    {
      // Relay mismatch is critical
      if (
        activeFault ==
        RELAY_MISMATCH
      )
      {
        setRelay(false);

        transitionTo(
          SHUTDOWN,
          activeFault,
          activeFaultSource
        );

        return;
      }

      // Other faults -> FAILSAFE
      setRelay(false);

      transitionTo(
        FAILSAFE,
        activeFault,
        activeFaultSource
      );

      recoveryStartTime = 0;
    }
  }

  // =======================================================
  // FAILSAFE
  // =======================================================

  else if (
    currentState == FAILSAFE
  )
  {
    // Relay mismatch -> shutdown
    if (
      detectedFault ==
      RELAY_MISMATCH
    )
    {
      setRelay(false);

      activeFault =
        RELAY_MISMATCH;

      activeFaultSource =
        SOURCE_RELAY;

      transitionTo(
        SHUTDOWN,
        activeFault,
        activeFaultSource
      );

      return;
    }

    // Safe recovery verification
    if (
      safeForRecovery()
    )
    {
      if (
        recoveryStartTime == 0
      )
      {
        recoveryStartTime =
          currentTime;

        Serial.println(
          "[RECOVERY] Verification started"
        );
      }

      // Recovery completed
      if (
        currentTime -
        recoveryStartTime
        >= RECOVERY_TIME
      )
      {
        Serial.println(
          "[RECOVERY] Verification successful"
        );

        activeFault = NO_FAULT;

        activeFaultSource =
          SOURCE_NONE;

        recoveryStartTime = 0;

        setRelay(true);

        transitionTo(
          NORMAL,
          NO_FAULT,
          SOURCE_NONE
        );
      }
    }
    else
    {
      recoveryStartTime = 0;
    }
  }

  // =======================================================
  // SHUTDOWN
  // =======================================================

  else if (
    currentState == SHUTDOWN
  )
  {
    // Safe shutdown
    setRelay(false);

    // Intentionally no automatic restart
  }

  // =======================================================
  // UPDATE HISTORY
  // =======================================================

  for (int i = 0; i < CELL_COUNT; i++)
  {
    previousVoltage[i] =
      cellVoltage[i];
  }
}

// =========================================================
// RELAY CONTROL
// =========================================================

void setRelay(bool state)
{
  if (
    relayState == state
  )
  {
    return;
  }

  relayState = state;

  actualRelayState =
    relayState;

  Serial.print("[");
  Serial.print(millis());
  Serial.print(" ms] RELAY: ");

  if (relayState)
  {
    Serial.println("ON");
  }
  else
  {
    Serial.println("OFF");
  }

  forceLcdRedraw = true;
}

// =========================================================
// FAULT NAME
// =========================================================

const char* getFaultName(
  FaultType fault
)
{
  switch (fault)
  {
    case NO_FAULT:
      return "NO_FAULT";

    case UNDER_VOLTAGE:
      return "UNDER_VOLTAGE";

    case OVER_VOLTAGE:
      return "OVER_VOLTAGE";

    case FROZEN_ADC:
      return "FROZEN_ADC";

    case ADC_JUMP:
      return "ADC_JUMP";

    case ADC_OUT_OF_RANGE:
      return "ADC_OUT_OF_RANGE";

    case RELAY_MISMATCH:
      return "RELAY_MISMATCH";

    case COMMUNICATION_FAILURE:
      return "COMM_FAILURE";

    default:
      return "UNKNOWN";
  }
}

// =========================================================
// FAULT SOURCE NAME
// =========================================================

const char* getFaultSourceName(
  FaultSource source
)
{
  switch (source)
  {
    case SOURCE_NONE:
      return "NONE";

    case SOURCE_BATTERY:
      return "BATTERY";

    case SOURCE_ADC:
      return "ADC";

    case SOURCE_RELAY:
      return "RELAY";

    case SOURCE_COMMUNICATION:
      return "COMMUNICATION";

    default:
      return "UNKNOWN";
  }
}

// =========================================================
// STATE NAME
// =========================================================

const char* getStateName(
  SystemState state
)
{
  switch (state)
  {
    case NORMAL:
      return "NORMAL";

    case DEGRADED:
      return "DEGRADED";

    case FAILSAFE:
      return "FAILSAFE";

    case SHUTDOWN:
      return "SHUTDOWN";

